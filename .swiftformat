--swiftversion 6.0
--indent 4
--maxwidth 130
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--closingparen balanced
--commas inline
--semicolons never
--stripunusedargs closure-only
--self remove
--importgrouping alpha
--header ignore
--decimalgrouping 3,5
--ranges no-space
--patternlet inline
--disable redundantReturn,wrapMultilineStatementBraces,blankLinesAtStartOfScope,organizeDeclarations,wrapIfStatementBodies,wrapPropertyBodies,docComments
--exclude Packages/QuickTodoKit/.build,DerivedData
